---
// Estado vazio — exibido quando não há conteúdo disponível.
interface Props {
  title?: string;
  message?: string;
}
const {
  title = 'Nenhum conteúdo disponível',
  message = 'Em breve esta seção será atualizada com o material oficial da escola.',
} = Astro.props;
---

<div class="state" role="status">
  <p class="state__title">{title}</p>
  <p>{message}</p>
</div>
