---
// Card institucional da diretoria — foto grande em preto e branco, cargo e nome.
interface Props {
  role: string;
  name: string;
  photo: string;
}
const { role, name, photo } = Astro.props;
---

<article class="dir-card" data-reveal>
  <button
    type="button"
    class="dir-card__photo"
    data-lb-open
    data-lb-src={photo}
    data-lb-alt={`Retrato ilustrativo — ${role}`}
    data-lb-caption={`${name} · ${role}`}
    aria-label={`Ampliar foto: ${name} — ${role}`}
  >
    <img
      src={photo}
      alt={`Retrato ilustrativo — ${role}`}
      width="800"
      height="1000"
      loading="lazy"
      decoding="async"
    />
  </button>
  <div class="dir-card__body">
    <span class="dir-card__role">{role}</span>
    <h3 class="dir-card__name">{name}</h3>
  </div>
</article>

<style>
  .dir-card {
    display: flex;
    flex-direction: column;
  }

  /* Foto clicável: abre o lightbox com nome e cargo na legenda.
     Sem badge visível (pedido do cliente) — só cursor e foco. */
  .dir-card__photo {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    margin: 0;
    overflow: hidden;
    background: var(--paper-deep);
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .dir-card__photo:focus-visible {
    outline: 2px solid #d9ad5e;
    outline-offset: 3px;
  }

  .dir-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.06);
    transition: transform 1.1s var(--ease), filter 0.7s var(--ease);
  }

  .dir-card:hover .dir-card__photo img {
    transform: scale(1.04);
    filter: grayscale(0.12) contrast(1.02);
  }

  /* Nome e cargo sobre fundo vermelho — identidade da escola.
     min-height: piso único (>= a maior natural, medida em 140px) para que
     todos os blocos tenham exatamente o mesmo tamanho, inclusive os casais;
     flex: 1 mantém o bloco igual ao dos vizinhos quando a linha estica. */
  .dir-card__body {
    flex: 1;
    min-height: 9rem;
    padding: 1.05rem 1.1rem 1.15rem;
    background: var(--red);
    color: #fff;
  }

  .dir-card__body::before {
    content: "";
    display: block;
    width: 30px;
    height: 2px;
    background: var(--gold);
    margin-bottom: 0.85rem;
  }

  .dir-card__role {
    display: block;
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(247, 244, 239, 0.85);
  }

  .dir-card__name {
    margin-top: 0.45rem;
    font-size: clamp(1.12rem, 1.5vw, 1.32rem);
    font-weight: 600;
    line-height: 1.2;
    color: #fff;
  }
</style>
