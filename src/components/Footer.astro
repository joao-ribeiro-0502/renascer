    key: 'whatsapp',
    label: 'WhatsApp',
    href: '#',
    path: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z',
  },
];

const institutional = nav.find((n) => n.label === 'A Escola')?.children ?? [];
const carnavalNav = nav.find((n) => n.label === 'Carnaval')?.children ?? [];
const commNav = [
  { label: 'Notícias', href: '#' },
  { label: 'Agenda de eventos', href: '#' },
  { label: 'Galeria', href: '#' },
  { label: 'Contato', href: '#' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img
          src="/assets/images/logo-renascer-256.png"
          alt={`Emblema da ${site.name}`}
          width="96"
          height="96"
          loading="lazy"
        />
        <p class="site-footer__name">{site.name}</p>
        <p class="site-footer__tagline">{site.tagline}</p>
        <p class="site-footer__location">{site.location}</p>
      </div>

      <nav class="site-footer__col" aria-label="Institucional">
        <h2 class="site-footer__title">Institucional</h2>
        <ul>
          {institutional.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Carnaval">
        <h2 class="site-footer__title">Carnaval</h2>
        <ul>
          {carnavalNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="#">Agenda</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Comunicação">
        <h2 class="site-footer__title">Comunicação</h2>
        <ul>
          {commNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Contato</h2>
        <ul>
          {
            site.address ? (
              <li>{site.address}</li>
            ) : (
              <li class="pending">Endereço oficial a confirmar</li>
            )
          }
          {
            site.phone ? (
              <li><a href={`tel:${site.phone}`}>{site.phone}</a></li>
            ) : (
              <li class="pending">Telefone oficial a confirmar</li>
            )
          }
          {
            site.email ? (
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            ) : (
              <li class="pending">E-mail oficial a confirmar</li>
            )
          }
        </ul>
        <ul class="site-footer__social" aria-label="Redes sociais">
          {socialLinks.map((social) => (
            <li>
              <a
                href={social.href}
                class={`social-link social-link--${social.key}`}
                aria-label={social.label}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d={social.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {year} {site.name}. Todos os direitos reservados.
      </p>
      <p class="site-footer__credit">
        <img
          src="/assets/images/trinarysolutions-mark.png"
          alt=""
          width="154"
          height="160"
          loading="lazy"
          decoding="async"
        />
        <span>
          Desenvolvido por{' '}<a href="https://trinarysolutions.com.br" target="_blank" rel="noopener noreferrer">
            Trinary Solutions Software House
          </a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal);
    color: rgba(247, 244, 239, 0.82);
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
    border-top: 4px solid var(--red);
  }

  .site-footer__grid {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.7fr) repeat(3, minmax(0, 1fr)) minmax(0, 1.4fr);
    }
  }

  .site-footer__brand img {
    width: 84px;
    height: auto;
    margin-bottom: 1.1rem;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--paper);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .site-footer__tagline {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: rgba(247, 244, 239, 0.65);
    max-width: 30ch;
  }

  .site-footer__location {
    margin-top: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .site-footer__title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper);
    margin-bottom: 1.1rem;
  }

  .site-footer__col li + li {
    margin-top: 0.6rem;
  }

  .site-footer__col a {
    font-size: 0.92rem;
    color: rgba(247, 244, 239, 0.72);
    transition: color 0.25s var(--ease);
  }

  .site-footer__col a:hover {
    color: #fff;
  }

  .site-footer__col .pending {
    font-size: 0.86rem;
    color: var(--muted-light);
    font-style: italic;
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  /* A fileira de contatos empilha itens na vertical — anular na linha social */
  .site-footer__social li + li {
    margin-top: 0;
  }

  .site-footer__social a {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    transition:
      transform 0.25s var(--ease),
      filter 0.25s var(--ease);
  }

  .site-footer__social a:hover {
    transform: translateY(-3px);
    filter: brightness(1.08);
  }

  .site-footer__social svg {
    width: 18px;
    height: 18px;
    fill: #fff;
  }

  .social-link--instagram {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  }

  .social-link--youtube {
    background: #ff0000;
  }

  .social-link--x {
    background: #fff;
  }

  .social-link--x svg {
    fill: #14171a;
  }

  .social-link--whatsapp {
    background: #25d366;
  }

  .site-footer__bottom {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    font-size: 0.8rem;
    color: var(--muted-light);
  }

  /* Goteira para o botão "voltar ao topo" (fixo no canto) não cobrir o crédito */
  @media (max-width: 1360px) {
    .site-footer__bottom {
      padding-right: 3.5rem;
    }
  }

  /* Crédito de desenvolvimento — discreto, na linha de baixo */
  .site-footer__credit {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 44ch;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted-light);
  }

  .site-footer__credit img {
    flex: none;
    height: 16px;
    width: auto;
  }

  .site-footer__credit a {
    color: rgba(247, 244, 239, 0.78);
    text-underline-offset: 2px;
    transition: color 0.25s var(--ease);
  }

  .site-footer__credit a:hover {
    color: #d9ad5e;
  }
</style>
