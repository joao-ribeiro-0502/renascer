---
// Rodapé institucional — navegação, contato e identidade.
import { nav, site } from '../data/site';

const year = new Date().getFullYear();
const socialEntries = Object.entries(site.social).filter(([, url]) => Boolean(url)) as [
  string,
  string
][];

const institutional = nav.find((n) => n.label === 'A Escola')?.children ?? [];
const carnavalNav = nav.find((n) => n.label === 'Carnaval')?.children ?? [];
const commNav = [
  { label: 'Notícias', href: '/noticias' },
  { label: 'Agenda de eventos', href: '/eventos' },
  { label: 'Galeria', href: '/galeria' },
  { label: 'Contato', href: '/contato' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img
          src="/assets/images/logo-renascer-256.png"
          alt={`Emblema da ${site.name}`}
          width="96"
          height="96"
          loading="lazy"
        />
        <p class="site-footer__name">{site.name}</p>
        <p class="site-footer__tagline">{site.tagline}</p>
        <p class="site-footer__location">{site.location}</p>
      </div>

      <nav class="site-footer__col" aria-label="Institucional">
        <h2 class="site-footer__title">Institucional</h2>
        <ul>
          {institutional.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Carnaval">
        <h2 class="site-footer__title">Carnaval</h2>
        <ul>
          {carnavalNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href="/eventos">Agenda</a></li>
        </ul>
      </nav>

      <nav class="site-footer__col" aria-label="Comunicação">
        <h2 class="site-footer__title">Comunicação</h2>
        <ul>
          {commNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__title">Contato</h2>
        <ul>
          {
            site.address ? (
              <li>{site.address}</li>
            ) : (
              <li class="pending">Endereço oficial a confirmar</li>
            )
          }
          {
            site.phone ? (
              <li><a href={`tel:${site.phone}`}>{site.phone}</a></li>
            ) : (
              <li class="pending">Telefone oficial a confirmar</li>
            )
          }
          {
            site.email ? (
              <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            ) : (
              <li class="pending">E-mail oficial a confirmar</li>
            )
          }
        </ul>
        {
          socialEntries.length > 0 ? (
            <ul class="site-footer__social">
              {socialEntries.map(([name, url]) => (
                <li>
                  <a href={url} rel="noopener noreferrer" target="_blank">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="pending" style="margin-top:0.75rem">
              Redes sociais oficiais em breve.
            </p>
          )
        }
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        © {year} {site.name}. Todos os direitos reservados.
      </p>
      <p class="site-footer__credit">
        <img
          src="/assets/images/trinarysolutions-mark.png"
          alt=""
          width="154"
          height="160"
          loading="lazy"
          decoding="async"
        />
        <span>
          Desenvolvido por{' '}<a href="https://trinarysolutions.com.br" target="_blank" rel="noopener noreferrer">
            Trinary Solutions Software House
          </a>
        </span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--charcoal);
    color: rgba(247, 244, 239, 0.82);
    padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem;
    border-top: 4px solid var(--red);
  }

  .site-footer__grid {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr));
    }
  }

  .site-footer__brand img {
    width: 84px;
    height: auto;
    margin-bottom: 1.1rem;
  }

  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--paper);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .site-footer__tagline {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    color: rgba(247, 244, 239, 0.65);
    max-width: 30ch;
  }

  .site-footer__location {
    margin-top: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--muted-light);
  }

  .site-footer__title {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--paper);
    margin-bottom: 1.1rem;
  }

  .site-footer__col li + li {
    margin-top: 0.6rem;
  }

  .site-footer__col a {
    font-size: 0.92rem;
    color: rgba(247, 244, 239, 0.72);
    transition: color 0.25s var(--ease);
  }

  .site-footer__col a:hover {
    color: #fff;
  }

  .site-footer__col .pending {
    font-size: 0.86rem;
    color: var(--muted-light);
    font-style: italic;
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.1rem;
  }

  .site-footer__social a {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-footer__bottom {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    font-size: 0.8rem;
    color: var(--muted-light);
  }

  /* Goteira para o botão "voltar ao topo" (fixo no canto) não cobrir o crédito */
  @media (max-width: 1360px) {
    .site-footer__bottom {
      padding-right: 3.5rem;
    }
  }

  /* Crédito de desenvolvimento — discreto, na linha de baixo */
  .site-footer__credit {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-width: 44ch;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted-light);
  }

  .site-footer__credit img {
    flex: none;
    height: 16px;
    width: auto;
  }

  .site-footer__credit a {
    color: rgba(247, 244, 239, 0.78);
    text-underline-offset: 2px;
    transition: color 0.25s var(--ease);
  }

  .site-footer__credit a:hover {
    color: #d9ad5e;
  }
</style>
