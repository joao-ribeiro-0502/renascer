---
// Página inicial — apresentação institucional e porta de entrada do site.
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Figure from '../components/Figure.astro';
import EventCard from '../components/EventCard.astro';
import CTA from '../components/CTA.astro';
import { site } from '../data/site';
import { getLatestNews } from '../data/news';
import { getUpcomingEvents } from '../data/events';
import { getLatestEnredo } from '../data/enredos';
import { getSegments } from '../data/segments';
import { gallery } from '../data/gallery';
import { carnaval } from '../data/carnaval';
import { formatDate } from '../utils/format';

const latestNews = getLatestNews(4);
const [featured, ...restNews] = latestNews;
const upcoming = getUpcomingEvents(3);
const enredo = getLatestEnredo();
const segments = getSegments();
const strip = gallery.slice(0, 5);
---

<BaseLayout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero__media" aria-hidden="true">
      <img
        src="/assets/images/hero/renascer-hero.jpg"
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
      />
    </div>
    <div class="container hero__content">
      <span class="eyebrow">{site.acronym} · {site.location}</span>
      <h1 class="hero__title">Renascer<br /><em>de Jacarepaguá</em></h1>
      <p class="hero__lead">
        Uma escola de samba feita de história, cultura e comunidade — o samba que nasce em
        Jacarepaguá e pulsa o ano inteiro.
      </p>
      <div class="btn-row">
        <ButtonLink href="/escola" variant="primary" label="Conhecer a escola" />
        <ButtonLink href="/noticias" variant="ghost" label="Últimas notícias" />
      </div>
    </div>
    <span class="hero__scroll" aria-hidden="true">Role</span>
  </section>

  <!-- APRESENTAÇÃO DA ESCOLA -->
  <section class="section">
    <div class="container">
      <div class="two-col about">
        <div data-reveal>
          <span class="eyebrow">A escola</span>
          <h2 class="display-title">
            A Renascer é um ponto de encontro entre tradição, território e gente.
          </h2>
          <div class="prose" style="margin-top:1.5rem">
            <p>
              A {site.fullName} tem em Jacarepaguá o seu território e na comunidade a sua
              razão de existir. Ao longo do ano, a escola reúne gerações em torno do samba,
              do ensaio e da vida coletiva.
            </p>
            <p>
              Este site institucional reúne a história, o carnaval, as notícias, a agenda e o
              acervo da Renascer em um só lugar — uma casa digital para quem faz a escola e
              para quem quer se aproximar dela.
            </p>
          </div>
          <div class="btn-row">
            <a class="arrow-link" href="/escola">Saiba mais sobre a escola</a>
            <a class="arrow-link" href="/historia" style="color:var(--muted)">Nossa história</a>
          </div>
        </div>
        <div data-reveal>
          <Figure
            src="/assets/images/bandeira-textura.jpg"
            alt="Bandeira oficial da G.R.E.S. Renascer de Jacarepaguá"
            ratio="4 / 3"
            caption="Bandeira oficial da escola · identidade da Renascer de Jacarepaguá"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- DESTAQUE DO CARNAVAL ATUAL -->
  <section class="section section--dark">
    <div class="container">
      <div class="feature feature--split feature--reverse">
        <div class="feature__media" data-reveal>
          <div class="figure figure--hoverable">
            <img src={enredo.image} alt={enredo.imageAlt} loading="lazy" decoding="async" />
          </div>
          <span class="feature__year" aria-hidden="true">{carnaval.year}</span>
        </div>
        <div data-reveal>
          <span class="eyebrow">Carnaval {carnaval.year} · {carnaval.status}</span>
          <h2 class="display-title">{enredo.title}</h2>
          <p class="lead" style="margin-top:1.2rem">{enredo.summary}</p>

          <dl class="ficha">
            <div class="ficha__row">
              <dt class="ficha__key">Samba-enredo</dt>
              <dd class="ficha__value">{enredo.sambaTitle ?? '—'}</dd>
            </div>
            <div class="ficha__row">
              <dt class="ficha__key">Compositores</dt>
              <dd class="ficha__value ficha__value--pending">A confirmar</dd>
            </div>
            <div class="ficha__row">
              <dt class="ficha__key">Carnavalesco</dt>
              <dd class="ficha__value ficha__value--pending">A confirmar</dd>
            </div>
            <div class="ficha__row">
              <dt class="ficha__key">Intérprete</dt>
              <dd class="ficha__value ficha__value--pending">A confirmar</dd>
            </div>
          </dl>

          <div class="btn-row">
            <ButtonLink href="/carnaval" variant="light" label="Área do carnaval" />
            <ButtonLink href={`/enredos/${enredo.slug}`} variant="ghost" label="Ver o enredo" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NOTÍCIAS -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Comunicação"
        title="Notícias"
        lead="Acompanhe o cotidiano da escola, os ensaios e os anúncios oficiais da comunicação institucional."
        link={{ href: '/noticias', label: 'Todas as notícias' }}
      />

      {
        featured && (
          <a class="featured-news" href={`/noticias/${featured.slug}`} data-reveal>
            <div class="featured-news__media">
              <img src={featured.image} alt={featured.imageAlt} loading="lazy" decoding="async" />
            </div>
            <div class="featured-news__body">
              <p class="content-card__meta">
                <span class="tag tag--red">{featured.category}</span>
                <time datetime={featured.date}>{formatDate(featured.date)}</time>
              </p>
              <h3 class="featured-news__title">{featured.title}</h3>
              <p class="featured-news__excerpt">{featured.excerpt}</p>
              <span class="arrow-link">Ler notícia</span>
            </div>
          </a>
        )
      }

      <div class="list-rows" style="margin-top:2.5rem" data-reveal>
        {
          restNews.map((n) => (
            <a class="list-row" href={`/noticias/${n.slug}`}>
              <div>
                <p class="list-row__meta">
                  <span>{n.category}</span>
                  <time datetime={n.date}>{formatDate(n.date)}</time>
                </p>
                <h3 class="list-row__title">{n.title}</h3>
              </div>
              <span class="list-row__arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PRÓXIMOS EVENTOS -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeader
        eyebrow="Agenda"
        title="Próximos eventos"
        lead="Ensaios, reuniões e apresentações que movimentam a temporada da escola."
        link={{ href: '/eventos', label: 'Agenda completa' }}
      />
      <div data-reveal>
        {upcoming.map((event) => <EventCard item={event} />)}
      </div>
    </div>
  </section>

  <!-- GALERIA -->
  <section class="section section--deep">
    <div class="container">
      <SectionHeader
        eyebrow="Acervo visual"
        title="Galeria"
        lead="Imagens da identidade, dos eventos e da vida da escola reunidas em um acervo em construção."
        link={{ href: '/galeria', label: 'Abrir galeria' }}
      />
      <div class="strip" data-reveal>
        {
          strip.map((item, i) => (
            <a
              class={`strip__item strip__item--${i + 1}`}
              href="/galeria"
              aria-label={`Ver galeria: ${item.caption}`}
            >
              <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SEGMENTOS -->
  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Comunidade"
        title="Segmentos"
        lead="Cada segmento guarda uma função, uma história e uma maneira própria de fazer a escola acontecer."
        link={{ href: '/segmentos', label: 'Todos os segmentos' }}
      />
      <div class="segment-list" data-reveal>
        {
          segments.map((segment, i) => (
            <a class="segment-item" href={`/segmentos/${segment.slug}`}>
              <span class="segment-item__index">{String(i + 1).padStart(2, '0')}</span>
              <span>
                <h3 class="segment-item__name">{segment.name}</h3>
                <p class="segment-item__text">{segment.summary}</p>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA INSTITUCIONAL -->
  <CTA
    eyebrow="Faça parte"
    title="A Renascer se faz com gente. A sua presença faz diferença."
    text="Quer integrar um segmento, colaborar com a escola ou tirar dúvidas sobre a temporada? Fale com a comunicação institucional."
    primary={{ href: '/contato', label: 'Entrar em contato' }}
    secondary={{ href: '/segmentos', label: 'Conhecer os segmentos' }}
  />
</BaseLayout>

<style>
  /* Apresentação */
  .about {
    align-items: center;
  }

  /* Notícia em destaque */
  .featured-news {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .featured-news {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .featured-news__media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--paper-deep);
  }

  .featured-news__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .featured-news:hover .featured-news__media img {
    transform: scale(1.045);
  }

  .featured-news__title {
    margin-top: 1rem;
    font-size: clamp(1.5rem, 2.6vw, 2.15rem);
    transition: color var(--dur) var(--ease);
  }

  .featured-news:hover .featured-news__title {
    color: var(--red);
  }

  .featured-news__excerpt {
    margin-top: 0.9rem;
    color: var(--muted);
    max-width: 58ch;
  }

  .featured-news .arrow-link {
    margin-top: 1.25rem;
  }

  /* Faixa da galeria */
  .strip {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .strip__item {
    overflow: hidden;
    background: var(--charcoal-soft);
    grid-column: span 3;
    aspect-ratio: 4 / 3;
  }

  .strip__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease), opacity var(--dur) var(--ease);
    opacity: 0.92;
  }

  .strip__item:hover img {
    transform: scale(1.05);
    opacity: 1;
  }

  @media (min-width: 768px) {
    .strip__item--1 {
      grid-column: span 3;
      grid-row: span 2;
      aspect-ratio: auto;
    }
    .strip__item--2,
    .strip__item--3 {
      grid-column: span 3;
    }
    .strip__item--4,
    .strip__item--5 {
      grid-column: span 3;
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 767px) {
    .strip {
      grid-template-columns: repeat(2, 1fr);
    }
    .strip__item {
      grid-column: span 1;
    }
    .strip__item--1 {
      grid-column: span 2;
      aspect-ratio: 16 / 9;
    }
  }
</style>
